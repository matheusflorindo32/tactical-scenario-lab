APP_NAME="Tactical Scenario Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Chave HMAC estável para busca exata e duplicidade de PII.
# Gere um segredo forte e não o rotacione junto com APP_KEY.
# Obrigatória em produção e deve permanecer somente no servidor.
PII_FINGERPRINT_KEY=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desenvolvimento/teste local pode continuar usando SQLite.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tactical_scenario
# DB_USERNAME=tactical_runtime
# DB_PASSWORD=
# DB_SSLMODE=verify-full
# PGSSLROOTCERT=

# Em produção, use PostgreSQL e execute `php artisan production:preflight`
# antes de migrations/deploy. DB_SSLMODE=disable é recusado em produção;
# verify-full é preferível quando o provedor suporta validação de CA/hostname.
# DB_CONNECTION=pgsql
# DB_HOST=your-managed-postgres-host
# DB_PORT=5432
# DB_DATABASE=tactical_scenario
# DB_USERNAME=tactical_runtime
# DB_PASSWORD=use-a-secret-manager
# DB_SSLMODE=verify-full
# PGSSLROOTCERT=/path/to/provider-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Produção HTTPS:
# SESSION_SECURE_COOKIE=true
# PRODUCTION_REQUIRE_SECURE_SESSION=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# O deployment atual possui somente o serviço web e o código não usa jobs assíncronos.
# QUEUE_CONNECTION=sync é o contrato da topologia atual até existir um worker dedicado e validado.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production readiness contract (names only; never commit real secrets):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-host.example
# APP_KEY=<server-side secret>
# PII_FINGERPRINT_KEY=<distinct server-side secret>
# DB_CONNECTION=pgsql
# DB_SSLMODE=verify-full
# SESSION_DRIVER=database-or-redis
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=database-or-redis
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
# QUEUE_CONNECTION=sync # enquanto não houver worker/jobs assíncronos

# VITE_* is public client-side configuration. Never place secrets here.
VITE_APP_NAME="${APP_NAME}"
